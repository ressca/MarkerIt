{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api",
  "projectType": "application",
  "sourceRoot": "apps/api/src/main/java",
  "tags": ["type:application", "scope:api", "platform:backend"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gradle bootRun",
        "cwd": "apps/api"
      },
      "cache": false,
      "continuous": true
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "gradle test jacocoCoverageVerification",
        "cwd": "apps/api"
      },
      "cache": true
    }
  }
}
